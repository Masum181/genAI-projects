# Copy to .env for local development and replace placeholders as needed.
APP_NAME=Enterprise Knowledge Intelligence Platform
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/enterprise_rag
DATABASE_ECHO=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=enterprise-rag-documents
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_SECURE=false

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_OPENAI_API_KEY=
LLM_GEMINI_API_KEY=

POSTGRES_DB=enterprise_rag
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-password
